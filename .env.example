# 环境变量样例：复制为 .env 后填入你的 Key

# ========== 翻译引擎 ==========
# deepseek（推荐）| google（免费）| openai | deepl | dummy（离线自测）
TRANSLATION_ENGINE=deepseek

# DeepSeek：https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=sk-your-key-here
# DEEPSEEK_MODEL=deepseek-chat

# OpenAI（可选）
# OPENAI_API_KEY=sk-your-key-here
# OPENAI_MODEL=gpt-4o

# DeepL（可选）
# DEEPL_API_KEY=your-deepl-key-here

# ========== 翻译调优 ==========
# 一次 API 请求翻译多少条文本（默认 12）
# TRANSLATION_BATCH_SIZE=12
# 单个批次的总字符上限
# TRANSLATION_BATCH_MAX_CHARS=1500
# 翻译缓存（相同原文不重复调用 API，支持断点续跑）
# TRANSLATION_CACHE=1

# ========== OCR ==========
# easyocr（推荐）| tesseract
OCR_ENGINE=easyocr
# auto | on | off —— 没有 GPU 时自动用 CPU
OCR_GPU=auto
# 低于该置信度的识别结果不翻译，保留原图文字
# OCR_MIN_CONFIDENCE=0.30
# 页面由多个小图拼成时，整页渲染后再 OCR 的 DPI
# PDF_RENDER_DPI=200
# TESSERACT_CMD=/opt/homebrew/bin/tesseract

# ========== 输出效果 ==========
# 中文字体（留空自动检测）
# FONT_PATH=/System/Library/Fonts/Hiragino Sans GB.ttc
# 自动选字体的风格偏好：serif（宋体，贴近日文印刷品）| sans（黑体）
# FONT_STYLE=serif
# 覆盖原文的底色：sample（取自原图，默认）| white
# OVERLAY_FILL_MODE=sample
# 译文颜色：auto（按底色自动取黑/白）| black | white
# OVERLAY_TEXT_COLOR=auto
# 译文允许的最小字号（日文小字 PDF 可降到 2.5）
# OVERLAY_MIN_FONT=3.0
# 放不下时是否允许向空白处扩展文本框（密集表格建议关闭）
# OVERLAY_EXPAND=0
# DOCX 内嵌图片是否 OCR 后重绘
# DOCX_TRANSLATE_IMAGES=0

# ========== 调试 ==========
# DEBUG=1
